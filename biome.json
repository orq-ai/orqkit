{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/build",
      "!**/dist",
      "!**/.nx",
      "!node_modules",
      "!**/*.generated.ts",
      "!packages/evaluatorq/static/*.min.js",
      "!packages/evaluatorq/tests/lib/dashboard/fixtures/integration/runs/unparseable.json",
      "!**/.claude",
      "!**/.taskmaster",
      "!**/.venv",
      "!**/__pycache__",
      "!**/*.egg-info",
      "!**/report.css",
      "!**/crypto_stealing_demo/orq-theme.css",
      "!**/crypto_stealing_demo/styles.scss",
      "!**/crypto_stealing_demo/presentation.qmd",
      "!**/refund_agent_demo/assets",
      "!**/refund_agent_demo/imgs",
      "!**/refund_agent_demo/presentation.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "overrides": [
    {
      "includes": ["packages/evaluatorq/tests/**/fixtures/**/*.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "packages/evaluatorq/static/**",
        "packages/evaluatorq/tests/lib/dashboard/js/minidom.cjs"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "recommended": false
        }
      },
      "assist": {
        "enabled": false
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", "!@orq-ai/**"],
              ":BLANK_LINE:",
              "@orq-ai/**",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  }
}
